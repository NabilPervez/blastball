{
 "schemaVersion": 1,
 "engine": "Web Audio synthesis only, no audio files",
 "throttleMs": 400,
 "bigMomentsOnly": [
  "homeRun",
  "walkoff",
  "envAnnounce",
  "death",
  "resurrection",
  "achievement",
  "championship"
 ],
 "cues": {
  "batCrack": {
   "on": [
    "hit"
   ],
   "synth": [
    {
     "type": "noise",
     "durationMs": 60,
     "filter": {
      "type": "highpass",
      "freq": 2200
     },
     "gain": 0.6
    }
   ],
   "haptic": [
    15
   ]
  },
  "crowdSwell": {
   "on": [
    "hit.double",
    "hit.triple"
   ],
   "synth": [
    {
     "type": "noise",
     "durationMs": 900,
     "filter": {
      "type": "bandpass",
      "freq": 800,
      "q": 0.7
     },
     "attackMs": 200,
     "releaseMs": 600,
     "gain": 0.35
    }
   ],
   "haptic": [
    20
   ]
  },
  "homeRun": {
   "on": [
    "hit.homeRun"
   ],
   "synth": [
    {
     "type": "noise",
     "durationMs": 1800,
     "filter": {
      "type": "bandpass",
      "freq": 900,
      "q": 0.5
     },
     "attackMs": 150,
     "releaseMs": 1200,
     "gain": 0.5
    },
    {
     "type": "sine",
     "notes": [
      "C5",
      "E5",
      "G5"
     ],
     "stepMs": 120,
     "gain": 0.2
    }
   ],
   "haptic": [
    40,
    60,
    40
   ]
  },
  "walkoff": {
   "on": [
    "walkoff"
   ],
   "synth": [
    {
     "type": "triangle",
     "notes": [
      "G4",
      "C5",
      "E5",
      "G5",
      "C6"
     ],
     "stepMs": 110,
     "gain": 0.3
    },
    {
     "type": "noise",
     "durationMs": 2500,
     "filter": {
      "type": "bandpass",
      "freq": 900,
      "q": 0.5
     },
     "gain": 0.5
    }
   ],
   "haptic": [
    60,
    40,
    60,
    40,
    120
   ]
  },
  "glovePop": {
   "on": [
    "strikeout"
   ],
   "synth": [
    {
     "type": "noise",
     "durationMs": 40,
     "filter": {
      "type": "lowpass",
      "freq": 900
     },
     "gain": 0.5
    }
   ],
   "haptic": [
    10
   ]
  },
  "envAnnounce": {
   "on": [
    "envAnnounce"
   ],
   "synth": [
    {
     "type": "square",
     "notes": [
      "D4",
      "A4",
      "F#5"
     ],
     "stepMs": 160,
     "gain": 0.15,
     "vibratoHz": 6
    }
   ],
   "haptic": [
    30,
    30,
    30
   ]
  },
  "death": {
   "on": [
    "death"
   ],
   "synth": [
    {
     "type": "sine",
     "notes": [
      "A2"
     ],
     "durationMs": 2500,
     "gain": 0.3,
     "releaseMs": 1500
    }
   ],
   "haptic": [
    200
   ]
  },
  "resurrection": {
   "on": [
    "resurrection"
   ],
   "synth": [
    {
     "type": "sine",
     "chord": [
      "C4",
      "G4",
      "E5"
     ],
     "durationMs": 2500,
     "attackMs": 800,
     "gain": 0.2
    }
   ],
   "haptic": [
    30,
    80,
    30,
    80,
    30
   ]
  },
  "payout": {
   "on": [
    "betWon",
    "pickPaid"
   ],
   "synth": [
    {
     "type": "triangle",
     "notes": [
      "E6",
      "A6"
     ],
     "stepMs": 70,
     "gain": 0.2
    }
   ],
   "haptic": [
    15,
    30,
    15
   ]
  },
  "ballot": {
   "on": [
    "voteBought"
   ],
   "synth": [
    {
     "type": "noise",
     "durationMs": 80,
     "filter": {
      "type": "lowpass",
      "freq": 300
     },
     "gain": 0.5
    }
   ],
   "haptic": [
    25
   ]
  },
  "achievement": {
   "on": [
    "achievement",
    "championship"
   ],
   "synth": [
    {
     "type": "triangle",
     "notes": [
      "C5",
      "E5",
      "G5",
      "C6"
     ],
     "stepMs": 100,
     "gain": 0.25
    }
   ],
   "haptic": [
    40,
    40,
    80
   ]
  }
 }
}