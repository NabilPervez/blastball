{
  "id": "core",
  "name": "Core weirdness",
  "eventChancePerMille": { "calm": 60, "normal": 180, "weird": 380, "unhinged": 650 },
  "deathsPerSeason": { "calm": 0.5, "normal": 2, "weird": 4, "unhinged": 8 },
  "deathCauses": [
    "was struck by a rogue comet during warmups.",
    "walked into the outfield fog and never walked out.",
    "was absorbed by the scoreboard.",
    "simply stopped existing during the seventh-inning stretch.",
    "chased a foul ball into a different dimension.",
    "was carried off by an unusually determined flock of gulls."
  ],
  "playerMods": [
    { "id": "running-hot", "name": "Running Hot", "icon": "✶", "description": "+8 power, −6 control.", "delta": { "power": 8, "control": -6 } },
    { "id": "foggy", "name": "Foggy", "icon": "◐", "description": "−8 contact.", "delta": { "contact": -8 } },
    { "id": "blessed", "name": "Blessed", "icon": "✦", "description": "+6 contact, power and discipline.", "delta": { "contact": 6, "power": 6, "discipline": 6 } },
    { "id": "cursed", "name": "Cursed", "icon": "✕", "description": "−6 contact and discipline.", "delta": { "contact": -6, "discipline": -6 } },
    { "id": "magnetized", "name": "Magnetized", "icon": "◆", "description": "+10 defense, −5 speed.", "delta": { "defense": 10, "speed": -5 } },
    { "id": "featherweight", "name": "Featherweight", "icon": "△", "description": "+12 speed, −8 power.", "delta": { "speed": 12, "power": -8 } },
    { "id": "insomniac", "name": "Insomniac", "icon": "☾", "description": "+6 velocity, −6 control.", "delta": { "velocity": 6, "control": -6 } },
    { "id": "echo", "name": "Echo", "icon": "◎", "description": "Came back from the Departed. +5 to everything.", "delta": { "contact": 5, "power": 5, "discipline": 5, "velocity": 5, "control": 5, "stuff": 5, "speed": 5, "defense": 5 }, "returnedOnly": true },
    { "id": "hollow", "name": "Hollow", "icon": "○", "description": "Came back from the Departed. +10 power and stuff, −8 discipline.", "delta": { "power": 10, "stuff": 10, "discipline": -8 }, "returnedOnly": true },
    { "id": "still-warm", "name": "Still Warm", "icon": "●", "description": "Came back from the Departed. +6 contact and velocity.", "delta": { "contact": 6, "velocity": 6 }, "returnedOnly": true }
  ],
  "stadiumMods": [
    { "id": "low-ceiling", "name": "Low Ceiling", "icon": "▣", "description": "Everyone hits with −8 power here.", "appliesTo": "all", "delta": { "power": -8 } },
    { "id": "sloped-outfield", "name": "Sloped Outfield", "icon": "◢", "description": "+8 speed, −6 defense for everyone.", "appliesTo": "all", "delta": { "speed": 8, "defense": -6 } },
    { "id": "haunted-dugout", "name": "Haunted Visitors' Dugout", "icon": "☾", "description": "Visiting players get −8 control and −6 discipline.", "appliesTo": "away", "delta": { "control": -8, "discipline": -6 } },
    { "id": "roaring-crowd", "name": "Roaring Crowd", "icon": "♪", "description": "Home batters get +6 contact.", "appliesTo": "home", "delta": { "contact": 6 } }
  ],
  "events": [
    {
      "id": "player-mod",
      "weight": 6,
      "minChaos": "calm",
      "target": "player",
      "effect": { "type": "addPlayerMod", "mods": ["running-hot", "foggy", "blessed", "cursed", "magnetized", "featherweight", "insomniac"], "durationDays": [3, 10] },
      "text": "{player} of the {team} is now {mod}."
    },
    {
      "id": "permanent-mark",
      "weight": 2,
      "minChaos": "normal",
      "target": "player",
      "effect": { "type": "addPlayerMod", "mods": ["blessed", "cursed", "magnetized", "featherweight"], "durationDays": null },
      "text": "{player} of the {team} has been permanently marked: {mod}."
    },
    {
      "id": "stadium-mod",
      "weight": 2,
      "minChaos": "normal",
      "target": "team",
      "effect": { "type": "addStadiumMod", "mods": ["low-ceiling", "sloped-outfield", "haunted-dugout", "roaring-crowd"], "durationDays": null },
      "text": "Overnight, {stadium} changed: {mod}."
    },
    {
      "id": "breakthrough",
      "weight": 3,
      "minChaos": "calm",
      "target": "player",
      "effect": { "type": "ratingDelta", "keys": ["contact", "power", "velocity", "stuff"], "amount": [3, 8] },
      "text": "{player} of the {team} had a breakthrough in practice."
    },
    {
      "id": "team-slump",
      "weight": 1,
      "minChaos": "weird",
      "target": "team",
      "effect": { "type": "teamRatingDelta", "keys": ["contact", "discipline"], "amount": [-5, -2] },
      "text": "A mysterious slump settles over the {team}."
    }
  ]
}
